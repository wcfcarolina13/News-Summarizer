# =============================================================================
# AI PROVIDER KEYS — you only need ONE to start.
# The app summarizes via a FREE multi-provider fallback chain (no card needed).
# Set any one key below and it works; add more for resilience against rate limits.
# =============================================================================

# Groq (fast free tier) — https://console.groq.com/keys
GROQ_API_KEY=

# Cloudflare Workers AI — https://dash.cloudflare.com/ (AI > Workers AI)
#   needs BOTH a token and your account id
CF_API_TOKEN=
CF_ACCOUNT_ID=

# Mistral — https://console.mistral.ai/
MISTRAL_API_KEY=

# Ollama Cloud — https://ollama.com/
OLLAMA_API_KEY=
# OLLAMA_CLOUD_MODEL=llama3.3-70b   # override the default cloud model

# OpenRouter (free models) — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Google Gemini (OPTIONAL, OFF by default). To use Gemini as well, set ENABLE_GEMINI=1.
#   https://aistudio.google.com/apikey
GEMINI_API_KEY=
ENABLE_GEMINI=0

# A/B switch for the briefing summarizer (OPTIONAL, unset = unchanged behaviour).
# "<provider>:<model>" is tried FIRST for the summarizer call sites only, then the
# normal chain. Providers: groq, cloudflare, mistral, ollama_cloud, openrouter.
# DAB_SUMMARIZER=groq:openai/gpt-oss-120b

# =============================================================================
# FALLBACK BEHAVIOR (optional)
# =============================================================================
# ENABLE_LOCAL_FALLBACK=1          # use a local Ollama model as a last resort
# OLLAMA_HOST=http://localhost:11434
# LOCAL_LLM_MODEL=gpt-oss:20b
# LOCAL_LLM_TIMEOUT=300
# DEBUG_FALLBACK=1                 # log which provider answered (1=on)
# ALLOW_EXTRACTIVE=0               # allow extractive fallback if all providers fail

# =============================================================================
# Google Sheets (optional) — place google_credentials.json in this directory.
# See README.md for service-account setup.
# =============================================================================

# =============================================================================
# API COST CONTROLS (optional — override api_usage.json; survive Render redeploys)
# =============================================================================
# API_DAILY_MAX_CALLS=100
# API_MONTHLY_MAX_CALLS=2000
# API_MONTHLY_BUDGET=0.50
# API_LIMITS_ENABLED=true
# API_COOLDOWN_ENABLED=true
# API_FREE_TIER_ONLY=true
